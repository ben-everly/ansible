{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["roles/pulumi/defaults/main.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+pulumi_cosign_version:\\s*\"(?<currentValue>.+?)\""
      ]
    }
  ]
}
